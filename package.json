{
  "name": "codex-bilibili-player",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "An independent local Codex-style development workspace for a future Bilibili player",
  "author": "Codex Bilibili Player",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "dashjs": "5.3.0",
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "36.9.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.codex.bilibili.player",
    "productName": "Codex Bilibili Player",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "assets/app.ico"
    },
    "portable": {
      "artifactName": "Codex-Bilibili-Player-${version}-x64.exe",
      "requestExecutionLevel": "user"
    },
    "electronDist": ".runtime/electron",
    "electronVersion": "36.9.5"
  }
}
